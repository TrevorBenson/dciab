#!/usr/bin/env bash
# DCiaB entrypoint. Each step is idempotent and runs in order:
#   validate -> [media] -> [services -> hypervisors] -> [templates] -> seed -> mgmt -> infra -> platform -> finalize
# media runs on the bootstrap appliance (or wherever spec.bootstrap.workDisk is set);
# services and hypervisors run only for sites that start from bare servers; templates only when
# the Proxmox VE node template isn't on templateNode yet.
set -euo pipefail

ROOT="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"

usage() {
  cat <<'EOF'
Usage: dciab <command> [options]

Commands:
  validate <config> [--output text|json] [--state DIR] [--live [--timeout SECONDS]]
                                           Check a site config; changes nothing. --live also asks the
                                           hypervisor API, BMCs, NTP and DNS servers, and probes addresses.
                                           --state: whose install records say what dciab hypervisors set up
  cluster-values <config> <cluster> [--state DIR] [--trust-bundle FILE] [-o FILE]
                                           Print a cluster's capi-cluster values (--list: cluster names)
  media <config> (--key PUB | --checksums-only) [--source DIR] [--cosign BIN] [--isos-from DIR] [--until STEP] [--print]
                                           Copy the archive to spec.bootstrap.workDisk and put container
                                           storage there (as root); prints the next steps with --state
                                           and --isos on the work disk
  services <config> [--state DIR] [--isos DIR] [--payload DIR] [--until STEP] [--print]
  services <config> --down [--state DIR] [--forget '<line>']
                                           Day 0 DNS, NTP and HTTP on the bootstrap host (as root)
  hypervisors <config> [--state DIR] [--isos DIR] [--iso FILE] [--host NAME ...] [--reinstall NAME ...]
              [--first-install NAME ...] [--age-identity FILE] [--timeout SECONDS] [--attach-timeout SECONDS]
              [--until STEP] [--print]
                                           Day 0: install Proxmox VE on spec.hypervisors.hosts over Redfish (as root)
  templates <config> [--state DIR] [--payload DIR] [--age-identity FILE] [--replace] [--timeout SECONDS] [--print]
                                           Publish the Proxmox VE node template from the archive's node disk (as root)
  seed <config> [--payload DIR] [--state DIR] [--age-identity FILE] [--force-new-ca] [--until STEP]
                                           Seed registry and bootstrap (kind) cluster from the payload
  seed <config> --remove [--state DIR] [--force] [--purge-state]
                                           Undo what seed did to this host (keeps the state unless --purge-state)
  mgmt <config> [--bootstrap-kubeconfig FILE] [--state DIR] [--trust-bundle FILE] [--payload DIR] [--until STEP]
                                           Build MGMT from the bootstrap cluster and move CAPI to it
  infra | platform | finalize              Bootstrap steps (not implemented yet)
  verify-archive (--key PUB | --checksums-only) [--cosign BIN] [ARCHIVE]
                                           Check the archive (this one by default) against its signed MANIFEST
  status <config> [--state DIR] [--output text|json]
                                           Where the bootstrap stands (read-only)
  verify                                   Site checks (not implemented yet)
  help                                     Show this help

Every site-specific value comes from the config. Nothing has a default.
EOF
}

require_python() {
  if ! command -v python3 >/dev/null 2>&1; then
    echo "dciab: python3 is required (Rocky Linux ships it as the python3 package)" >&2
    exit 2
  fi
  if ! python3 -c 'import sys; sys.exit(0 if sys.version_info >= (3, 12) else 1)'; then
    echo "dciab: python3 3.12 or newer is required (Rocky Linux 10's python3)" >&2
    exit 2
  fi
}

cmd="${1:-help}"
[[ $# -gt 0 ]] && shift

case "$cmd" in
  validate)
    if [[ $# -lt 1 ]]; then
      echo "dciab validate: give the config file, for example: ./dciab validate ./dciab.yaml" >&2
      exit 2
    fi
    require_python
    PYTHONPATH="$ROOT/lib${PYTHONPATH:+:$PYTHONPATH}" exec python3 -m dciab_validate --root "$ROOT" "$@"
    ;;
  cluster-values)
    require_python
    PYTHONPATH="$ROOT/lib${PYTHONPATH:+:$PYTHONPATH}" exec python3 -m dciab_cluster --root "$ROOT" "$@"
    ;;
  seed)
    require_python
    PYTHONPATH="$ROOT/lib${PYTHONPATH:+:$PYTHONPATH}" exec python3 -m dciab_seed --root "$ROOT" "$@"
    ;;
  media)
    require_python
    PYTHONDONTWRITEBYTECODE=1 PYTHONPATH="$ROOT/lib${PYTHONPATH:+:$PYTHONPATH}" \
      exec python3 -m dciab_media --root "$ROOT" "$@"
    ;;
  status)
    require_python
    PYTHONPATH="$ROOT/lib${PYTHONPATH:+:$PYTHONPATH}" exec python3 -m dciab_status --root "$ROOT" "$@"
    ;;
  verify-archive)
    require_python
    PYTHONDONTWRITEBYTECODE=1 PYTHONPATH="$ROOT/lib${PYTHONPATH:+:$PYTHONPATH}" \
      exec python3 -m dciab_archive --root "$ROOT" "$@"
    ;;
  mgmt)
    require_python
    exec "$ROOT/lib/steps/mgmt.sh" "$@"
    ;;
  services)
    require_python
    exec "$ROOT/lib/steps/services.sh" "$@"
    ;;
  hypervisors)
    require_python
    PYTHONPATH="$ROOT/lib${PYTHONPATH:+:$PYTHONPATH}" exec python3 -m dciab_hypervisors --root "$ROOT" "$@"
    ;;
  templates)
    require_python
    PYTHONPATH="$ROOT/lib${PYTHONPATH:+:$PYTHONPATH}" exec python3 -m dciab_templates --root "$ROOT" "$@"
    ;;
  infra|platform|finalize|verify)
    echo "dciab $cmd: not implemented yet (see docs/ROADMAP.md)" >&2
    exit 2
    ;;
  help|-h|--help)
    usage
    ;;
  *)
    echo "dciab: unknown command '$cmd'" >&2
    usage >&2
    exit 2
    ;;
esac
