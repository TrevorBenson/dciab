{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "capi-cluster values",
  "type": "object",
  "required": [
    "name",
    "class",
    "classVersion",
    "classNamespace",
    "kubernetesVersion",
    "apiVIP",
    "podCIDR",
    "serviceCIDR",
    "nodes",
    "controlPlane",
    "workerPools"
  ],
  "properties": {
    "name": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{1,18}[a-z0-9]$"
    },
    "class": {
      "enum": [
        "vsphere",
        "proxmox",
        "metal3"
      ]
    },
    "classVersion": {
      "type": "string",
      "pattern": "^v[0-9]+$"
    },
    "classNamespace": {
      "type": "string",
      "minLength": 1
    },
    "kubernetesVersion": {
      "type": "string",
      "pattern": "^v1\\.[0-9]+\\.[0-9]+$"
    },
    "apiVIP": {
      "$ref": "#/definitions/ipv4"
    },
    "podCIDR": {
      "$ref": "#/definitions/cidr"
    },
    "serviceCIDR": {
      "$ref": "#/definitions/cidr"
    },
    "labels": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "nodes": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "registryMirror",
        "trustBundle",
        "ntpServers",
        "sshAuthorizedKeys",
        "dnsServers"
      ],
      "properties": {
        "registryMirror": {
          "type": "string",
          "minLength": 1
        },
        "trustBundle": {
          "type": "string",
          "pattern": "-----BEGIN CERTIFICATE-----"
        },
        "ntpServers": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "sshAuthorizedKeys": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "dnsServers": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/definitions/ipv4"
          }
        },
        "oidc": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "issuerURL",
            "clientID"
          ],
          "properties": {
            "issuerURL": {
              "type": "string",
              "pattern": "^https://"
            },
            "clientID": {
              "type": "string"
            },
            "usernameClaim": {
              "type": "string"
            },
            "groupsClaim": {
              "type": "string"
            }
          }
        },
        "vipInterface": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._-]{1,15}$",
          "description": "optional: the interface kube-vip announces the API VIP on (default: the interface holding the default route)"
        }
      }
    },
    "network": {
      "$ref": "#/definitions/network"
    },
    "controlPlane": {
      "type": "object"
    },
    "workerPools": {
      "type": "array"
    },
    "vsphere": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "server",
        "thumbprint",
        "datacenter",
        "datastore",
        "folder",
        "resourcePool",
        "network",
        "template"
      ],
      "properties": {
        "server": {
          "type": "string"
        },
        "thumbprint": {
          "type": "string"
        },
        "datacenter": {
          "type": "string"
        },
        "datastore": {
          "type": "string"
        },
        "folder": {
          "type": "string"
        },
        "resourcePool": {
          "type": "string"
        },
        "network": {
          "type": "string"
        },
        "template": {
          "type": "string"
        }
      }
    },
    "proxmox": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "allowedNodes",
        "templateNode",
        "templateID",
        "storage",
        "bridge"
      ],
      "properties": {
        "allowedNodes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "templateNode": {
          "type": "string"
        },
        "templateID": {
          "type": "integer"
        },
        "storage": {
          "type": "string"
        },
        "bridge": {
          "type": "string"
        },
        "vlanTag": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4094
        }
      }
    },
    "metal3": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "image"
      ],
      "properties": {
        "image": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "url",
            "checksum",
            "checksumType",
            "diskFormat"
          ],
          "properties": {
            "url": {
              "type": "string",
              "pattern": "^https?://"
            },
            "checksum": {
              "type": "string"
            },
            "checksumType": {
              "enum": [
                "sha256",
                "sha512"
              ]
            },
            "diskFormat": {
              "enum": [
                "raw",
                "qcow2"
              ]
            }
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "class": {
            "enum": [
              "vsphere",
              "proxmox"
            ]
          }
        },
        "required": [
          "class"
        ]
      },
      "then": {
        "required": [
          "network"
        ],
        "properties": {
          "controlPlane": {
            "$ref": "#/definitions/vmControlPlane"
          },
          "workerPools": {
            "type": "array",
            "items": {
              "$ref": "#/definitions/vmPool"
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "class": {
            "const": "vsphere"
          }
        },
        "required": [
          "class"
        ]
      },
      "then": {
        "required": [
          "vsphere"
        ],
        "not": {
          "anyOf": [
            {
              "required": [
                "proxmox"
              ]
            },
            {
              "required": [
                "metal3"
              ]
            }
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "class": {
            "const": "proxmox"
          }
        },
        "required": [
          "class"
        ]
      },
      "then": {
        "required": [
          "proxmox"
        ],
        "not": {
          "anyOf": [
            {
              "required": [
                "vsphere"
              ]
            },
            {
              "required": [
                "metal3"
              ]
            }
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "class": {
            "const": "metal3"
          }
        },
        "required": [
          "class"
        ]
      },
      "then": {
        "required": [
          "metal3"
        ],
        "not": {
          "anyOf": [
            {
              "required": [
                "vsphere"
              ]
            },
            {
              "required": [
                "proxmox"
              ]
            },
            {
              "required": [
                "network"
              ]
            }
          ]
        },
        "properties": {
          "controlPlane": {
            "$ref": "#/definitions/metalControlPlane"
          },
          "workerPools": {
            "type": "array",
            "items": {
              "$ref": "#/definitions/metalPool"
            }
          }
        }
      }
    }
  ],
  "definitions": {
    "ipv4": {
      "type": "string",
      "pattern": "^(25[0-5]|2[0-4][0-9]|1[0-9][0-9]|[1-9]?[0-9])(\\.(25[0-5]|2[0-4][0-9]|1[0-9][0-9]|[1-9]?[0-9])){3}$",
      "description": "an IPv4 address"
    },
    "cidr": {
      "type": "string",
      "pattern": "^(25[0-5]|2[0-4][0-9]|1[0-9][0-9]|[1-9]?[0-9])(\\.(25[0-5]|2[0-4][0-9]|1[0-9][0-9]|[1-9]?[0-9])){3}/(3[0-2]|[12]?[0-9])$",
      "description": "an IPv4 network"
    },
    "network": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "nodeIPRange",
        "prefix",
        "gateway"
      ],
      "properties": {
        "nodeIPRange": {
          "type": "string",
          "pattern": "^(25[0-5]|2[0-4][0-9]|1[0-9][0-9]|[1-9]?[0-9])(\\.(25[0-5]|2[0-4][0-9]|1[0-9][0-9]|[1-9]?[0-9])){3}-(25[0-5]|2[0-4][0-9]|1[0-9][0-9]|[1-9]?[0-9])(\\.(25[0-5]|2[0-4][0-9]|1[0-9][0-9]|[1-9]?[0-9])){3}$",
          "description": "an inclusive IPv4 range: first-last"
        },
        "prefix": {
          "type": "integer",
          "minimum": 1,
          "maximum": 32
        },
        "gateway": {
          "$ref": "#/definitions/ipv4"
        }
      }
    },
    "machine": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cpu",
        "memoryGiB",
        "diskGiB"
      ],
      "properties": {
        "cpu": {
          "type": "integer",
          "minimum": 2
        },
        "memoryGiB": {
          "type": "integer",
          "minimum": 4
        },
        "diskGiB": {
          "type": "integer",
          "minimum": 40
        }
      }
    },
    "poolName": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,18}[a-z0-9]$"
    },
    "selector": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "string"
      }
    },
    "vmControlPlane": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "replicas",
        "machine"
      ],
      "properties": {
        "replicas": {
          "enum": [
            1,
            3,
            5
          ]
        },
        "machine": {
          "$ref": "#/definitions/machine"
        }
      }
    },
    "vmPool": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "replicas",
        "machine"
      ],
      "properties": {
        "name": {
          "$ref": "#/definitions/poolName"
        },
        "replicas": {
          "type": "integer",
          "minimum": 0
        },
        "machine": {
          "$ref": "#/definitions/machine"
        }
      }
    },
    "metalControlPlane": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "replicas",
        "hostSelector",
        "network"
      ],
      "properties": {
        "replicas": {
          "enum": [
            1,
            3,
            5
          ]
        },
        "hostSelector": {
          "$ref": "#/definitions/selector"
        },
        "network": {
          "$ref": "#/definitions/network"
        }
      }
    },
    "metalPool": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "replicas",
        "hostSelector",
        "network"
      ],
      "properties": {
        "name": {
          "allOf": [
            {
              "$ref": "#/definitions/poolName"
            },
            {
              "not": {
                "const": "controlplane"
              }
            }
          ],
          "description": "any pool name except 'controlplane', which names the control plane's IP pool"
        },
        "replicas": {
          "type": "integer",
          "minimum": 0
        },
        "hostSelector": {
          "$ref": "#/definitions/selector"
        },
        "network": {
          "$ref": "#/definitions/network"
        }
      }
    }
  }
}
