{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "capi-cluster values",
  "type": "object",
  "required": [
    "name",
    "class",
    "classRevision",
    "classNamespace",
    "kubernetesVersion",
    "apiVIP",
    "podCIDR",
    "serviceCIDR",
    "nodes",
    "podSecurity",
    "encryption",
    "controlPlane",
    "workerPools"
  ],
  "properties": {
    "name": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{1,18}[a-z0-9]$"
    },
    "class": {
      "enum": [
        "vsphere",
        "proxmox",
        "metal3"
      ]
    },
    "classNamespace": {
      "type": "string",
      "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$",
      "maxLength": 63
    },
    "kubernetesVersion": {
      "type": "string",
      "pattern": "^v1\\.[0-9]+\\.[0-9]+$"
    },
    "apiVIP": {
      "$ref": "#/definitions/ipv4"
    },
    "podCIDR": {
      "$ref": "#/definitions/cidr"
    },
    "serviceCIDR": {
      "$ref": "#/definitions/cidr"
    },
    "labels": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "nodes": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "registryMirror",
        "mirroredRegistries",
        "trustBundle",
        "ntpServers",
        "sshAuthorizedKeys",
        "dnsServers"
      ],
      "properties": {
        "registryMirror": {
          "type": "string",
          "minLength": 1
        },
        "mirroredRegistries": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9]([a-z0-9.-]*[a-z0-9])?$"
          },
          "description": "upstream registries nodes pull through registryMirror (bundle.lock mirroredRegistries)"
        },
        "trustBundle": {
          "type": "string",
          "pattern": "-----BEGIN CERTIFICATE-----"
        },
        "ntpServers": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "sshAuthorizedKeys": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "dnsServers": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/definitions/ipv4"
          }
        },
        "authentication": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "issuers"
          ],
          "properties": {
            "issuers": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "name",
                  "url",
                  "clientID"
                ],
                "properties": {
                  "name": {
                    "type": "string",
                    "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
                  },
                  "url": {
                    "type": "string",
                    "pattern": "^https://"
                  },
                  "clientID": {
                    "type": "string",
                    "minLength": 1
                  },
                  "usernameClaim": {
                    "type": "string"
                  },
                  "usernamePrefix": {
                    "type": "string",
                    "minLength": 1
                  },
                  "groupsClaim": {
                    "type": "string"
                  },
                  "groupsPrefix": {
                    "type": "string",
                    "minLength": 1
                  },
                  "certificateAuthority": {
                    "type": "string",
                    "pattern": "-----BEGIN CERTIFICATE-----"
                  }
                }
              }
            }
          },
          "description": "optional: JWT issuers the API server trusts (structured authentication)"
        },
        "vipInterface": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._-]{1,15}$",
          "description": "optional: the interface kube-vip announces the API VIP on (default: the interface holding the default route)"
        },
        "mtu": {
          "type": "integer",
          "minimum": 1280,
          "maximum": 9216,
          "description": "optional, VM classes: the node NIC's MTU"
        }
      }
    },
    "podSecurity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "exemptNamespaces"
      ],
      "properties": {
        "exemptNamespaces": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
          },
          "description": "namespaces Pod Security admission leaves alone (kube-system and the privileged CNI/CSI namespaces)"
        }
      }
    },
    "encryption": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "createSecret"
      ],
      "properties": {
        "createSecret": {
          "type": "boolean",
          "description": "create the <name>-encryption-config Secret (random key, kept on upgrade); false: it must already exist"
        }
      }
    },
    "network": {
      "$ref": "#/definitions/network"
    },
    "controlPlane": {
      "type": "object"
    },
    "workerPools": {
      "type": "array"
    },
    "vsphere": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "server",
        "thumbprint",
        "datacenter",
        "datastore",
        "folder",
        "resourcePool",
        "network",
        "template"
      ],
      "properties": {
        "server": {
          "type": "string"
        },
        "thumbprint": {
          "type": "string"
        },
        "datacenter": {
          "type": "string"
        },
        "datastore": {
          "type": "string"
        },
        "folder": {
          "type": "string"
        },
        "resourcePool": {
          "type": "string"
        },
        "network": {
          "type": "string"
        },
        "template": {
          "type": "string"
        }
      }
    },
    "proxmox": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "allowedNodes",
        "templateNode",
        "templateID",
        "storage",
        "bridge"
      ],
      "properties": {
        "allowedNodes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "templateNode": {
          "type": "string",
          "minLength": 1
        },
        "templateID": {
          "type": "integer"
        },
        "storage": {
          "type": "string"
        },
        "bridge": {
          "type": "string"
        },
        "vlanTag": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4094
        }
      }
    },
    "metal3": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "image"
      ],
      "properties": {
        "image": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "url",
            "checksum",
            "checksumType",
            "diskFormat"
          ],
          "properties": {
            "url": {
              "type": "string",
              "pattern": "^https?://"
            },
            "checksum": {
              "type": "string"
            },
            "checksumType": {
              "enum": [
                "sha256",
                "sha512"
              ]
            },
            "diskFormat": {
              "enum": [
                "raw",
                "qcow2"
              ]
            }
          }
        },
        "failureDomains": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "optional: the site's failure domains that have hosts for this cluster"
        }
      }
    },
    "classRevision": {
      "type": "string",
      "pattern": "^r[0-9]+$",
      "description": "ClusterClass revision, such as r1 (not a Kubernetes API version)"
    },
    "topology": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "region"
      ],
      "properties": {
        "region": {
          "type": "string",
          "minLength": 1
        },
        "zone": {
          "type": "string",
          "minLength": 1
        }
      },
      "description": "proxmox: topology.kubernetes.io labels the kubelets set (zone only on a one-domain site)"
    },
    "storageNetworks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "ipRange",
          "prefix"
        ],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
          },
          "ipRange": {
            "type": "string",
            "pattern": "^(25[0-5]|2[0-4][0-9]|1[0-9][0-9]|[1-9]?[0-9])(\\.(25[0-5]|2[0-4][0-9]|1[0-9][0-9]|[1-9]?[0-9])){3}-(25[0-5]|2[0-4][0-9]|1[0-9][0-9]|[1-9]?[0-9])(\\.(25[0-5]|2[0-4][0-9]|1[0-9][0-9]|[1-9]?[0-9])){3}$",
            "description": "an inclusive IPv4 range: first-last"
          },
          "prefix": {
            "type": "integer",
            "minimum": 1,
            "maximum": 32
          },
          "vlan": {
            "type": "integer",
            "minimum": 1,
            "maximum": 4094
          },
          "bridge": {
            "type": "string",
            "minLength": 1
          },
          "portGroup": {
            "type": "string",
            "minLength": 1
          },
          "mtu": {
            "type": "integer",
            "minimum": 1280,
            "maximum": 9216
          }
        }
      },
      "description": "optional, VM classes: storage networks; one NIC and one address pool per entry"
    },
    "vsphereFailureDomains": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "computeCluster"
        ],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
          },
          "computeCluster": {
            "type": "string",
            "minLength": 1
          },
          "hostGroup": {
            "type": "string",
            "minLength": 1
          },
          "vmGroup": {
            "type": "string",
            "minLength": 1
          },
          "datastore": {
            "type": "string",
            "minLength": 1
          },
          "network": {
            "type": "string",
            "minLength": 1
          }
        },
        "dependencies": {
          "hostGroup": [
            "vmGroup"
          ],
          "vmGroup": [
            "hostGroup"
          ]
        }
      },
      "description": "optional, vsphere: the failure domains this cluster uses (ADR 0010)"
    },
    "clusterModules": {
      "type": "boolean",
      "description": "vsphere: false only on a site without DRS"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "class": {
            "enum": [
              "vsphere",
              "proxmox"
            ]
          }
        },
        "required": [
          "class"
        ]
      },
      "then": {
        "required": [
          "network"
        ],
        "properties": {
          "controlPlane": {
            "$ref": "#/definitions/vmControlPlane"
          },
          "workerPools": {
            "type": "array",
            "items": {
              "$ref": "#/definitions/vmPool"
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "class": {
            "const": "vsphere"
          }
        },
        "required": [
          "class"
        ]
      },
      "then": {
        "required": [
          "vsphere"
        ],
        "not": {
          "anyOf": [
            {
              "required": [
                "proxmox"
              ]
            },
            {
              "required": [
                "metal3"
              ]
            },
            {
              "required": [
                "topology"
              ]
            }
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "class": {
            "const": "proxmox"
          }
        },
        "required": [
          "class"
        ]
      },
      "then": {
        "required": [
          "proxmox"
        ],
        "not": {
          "anyOf": [
            {
              "required": [
                "vsphere"
              ]
            },
            {
              "required": [
                "metal3"
              ]
            },
            {
              "required": [
                "vsphereFailureDomains"
              ]
            },
            {
              "required": [
                "clusterModules"
              ]
            }
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "class": {
            "const": "metal3"
          }
        },
        "required": [
          "class"
        ]
      },
      "then": {
        "required": [
          "metal3"
        ],
        "not": {
          "anyOf": [
            {
              "required": [
                "vsphere"
              ]
            },
            {
              "required": [
                "proxmox"
              ]
            },
            {
              "required": [
                "network"
              ]
            },
            {
              "required": [
                "storageNetworks"
              ]
            },
            {
              "required": [
                "topology"
              ]
            },
            {
              "required": [
                "vsphereFailureDomains"
              ]
            },
            {
              "required": [
                "clusterModules"
              ]
            }
          ]
        },
        "properties": {
          "controlPlane": {
            "$ref": "#/definitions/metalControlPlane"
          },
          "workerPools": {
            "type": "array",
            "items": {
              "$ref": "#/definitions/metalPool"
            }
          }
        }
      }
    }
  ],
  "definitions": {
    "ipv4": {
      "type": "string",
      "pattern": "^(25[0-5]|2[0-4][0-9]|1[0-9][0-9]|[1-9]?[0-9])(\\.(25[0-5]|2[0-4][0-9]|1[0-9][0-9]|[1-9]?[0-9])){3}$",
      "description": "an IPv4 address"
    },
    "cidr": {
      "type": "string",
      "pattern": "^(25[0-5]|2[0-4][0-9]|1[0-9][0-9]|[1-9]?[0-9])(\\.(25[0-5]|2[0-4][0-9]|1[0-9][0-9]|[1-9]?[0-9])){3}/(3[0-2]|[12]?[0-9])$",
      "description": "an IPv4 network"
    },
    "network": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "nodeIPRange",
        "prefix",
        "gateway"
      ],
      "properties": {
        "nodeIPRange": {
          "type": "string",
          "pattern": "^(25[0-5]|2[0-4][0-9]|1[0-9][0-9]|[1-9]?[0-9])(\\.(25[0-5]|2[0-4][0-9]|1[0-9][0-9]|[1-9]?[0-9])){3}-(25[0-5]|2[0-4][0-9]|1[0-9][0-9]|[1-9]?[0-9])(\\.(25[0-5]|2[0-4][0-9]|1[0-9][0-9]|[1-9]?[0-9])){3}$",
          "description": "an inclusive IPv4 range: first-last"
        },
        "prefix": {
          "type": "integer",
          "minimum": 1,
          "maximum": 32
        },
        "gateway": {
          "$ref": "#/definitions/ipv4"
        }
      }
    },
    "machine": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cpu",
        "memoryGiB",
        "diskGiB"
      ],
      "properties": {
        "cpu": {
          "type": "integer",
          "minimum": 2
        },
        "memoryGiB": {
          "type": "integer",
          "minimum": 4
        },
        "diskGiB": {
          "type": "integer",
          "minimum": 25
        }
      }
    },
    "poolName": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,18}[a-z0-9]$"
    },
    "selector": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "string"
      }
    },
    "vmControlPlane": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "replicas",
        "machine"
      ],
      "properties": {
        "replicas": {
          "enum": [
            1,
            3,
            5
          ]
        },
        "machine": {
          "$ref": "#/definitions/machine"
        }
      }
    },
    "vmPool": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "replicas",
        "machine"
      ],
      "properties": {
        "name": {
          "$ref": "#/definitions/poolName"
        },
        "replicas": {
          "type": "integer",
          "minimum": 0
        },
        "machine": {
          "$ref": "#/definitions/machine"
        },
        "failureDomain": {
          "type": "string",
          "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$",
          "description": "optional: the failure domain the pool runs in"
        }
      }
    },
    "metalControlPlane": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "replicas",
        "hostSelector",
        "network"
      ],
      "properties": {
        "replicas": {
          "enum": [
            1,
            3,
            5
          ]
        },
        "hostSelector": {
          "$ref": "#/definitions/selector"
        },
        "network": {
          "$ref": "#/definitions/network"
        }
      }
    },
    "metalPool": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "replicas",
        "hostSelector",
        "network"
      ],
      "properties": {
        "name": {
          "allOf": [
            {
              "$ref": "#/definitions/poolName"
            },
            {
              "not": {
                "const": "controlplane"
              }
            }
          ],
          "description": "any pool name except 'controlplane', which names the control plane's IP pool"
        },
        "replicas": {
          "type": "integer",
          "minimum": 0
        },
        "hostSelector": {
          "$ref": "#/definitions/selector"
        },
        "network": {
          "$ref": "#/definitions/network"
        },
        "failureDomain": {
          "type": "string",
          "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$",
          "description": "optional: the failure domain the pool runs in"
        },
        "addressPool": {
          "$ref": "#/definitions/poolName",
          "description": "set by cluster-values for a pool split over failure domains: the pool whose addresses it shares"
        }
      }
    }
  }
}
