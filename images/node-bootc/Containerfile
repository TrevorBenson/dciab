# DCiaB node image, image mode (bootc): Rocky Linux 10 + CRI-O + kubeadm.
# Built by build.sh; every version comes from bundle.lock (nodeImages.bootc).
#
# BASE_IMAGE is a Rocky Linux 10 bootc base: the RESF SIG/Containers rocky-bootc recipe
# built with its minimal manifest (bootc, systemd, kernel, dnf), or a prebuilt base
# pinned by digest.
ARG BASE_IMAGE
FROM ${BASE_IMAGE}

ARG KUBERNETES_VERSION
ARG KUBERNETES_SERIES
ARG CRIO_SERIES
# vm (Proxmox, vSphere) or metal (Metal3: adds every kernel driver and firmware).
ARG VARIANT=vm
# Package repos for Kubernetes (pkgs.k8s.io) and CRI-O (isv:cri-o on OBS), one minor each.
RUN cat > /etc/yum.repos.d/kubernetes.repo <<REPO
[kubernetes]
name=Kubernetes ${KUBERNETES_SERIES}
baseurl=https://pkgs.k8s.io/core:/stable:/${KUBERNETES_SERIES}/rpm/
enabled=1
gpgcheck=1
gpgkey=https://pkgs.k8s.io/core:/stable:/${KUBERNETES_SERIES}/rpm/repodata/repomd.xml.key
REPO
RUN cat > /etc/yum.repos.d/cri-o.repo <<REPO
[cri-o]
name=CRI-O ${CRIO_SERIES}
baseurl=https://download.opensuse.org/repositories/isv:/cri-o:/stable:/${CRIO_SERIES}/rpm/
enabled=1
gpgcheck=1
gpgkey=https://download.opensuse.org/repositories/isv:/cri-o:/stable:/${CRIO_SERIES}/rpm/repodata/repomd.xml.key
REPO

# kubelet/kubeadm/kubectl pinned to the bundle's Kubernetes version; CRI-O from its minor
# stream (the installed CRI-O version is recorded at build time). NetworkManager is
# cloud-init's network backend on EL; the minimal manifest may not include it.
# cloud-init: CAPMOX, CAPV and CAPM3 hand node config over as cloud-init data.
# iscsi-initiator-utils and nfs-utils: Longhorn attaches volumes over iSCSI and backs up
# to NFS targets (addons/longhorn).
# Guest agents for both hypervisors: each one's unit only starts on its own platform
# (qemu-guest-agent on its virtio port, vmtoolsd on VMware). CAPV needs VMware Tools to
# learn a node's address, and cloud-init's VMware datasource reads guestinfo through it.
RUN dnf -y install \
      container-selinux cri-o \
      "kubelet-${KUBERNETES_VERSION}" "kubeadm-${KUBERNETES_VERSION}" "kubectl-${KUBERNETES_VERSION}" cri-tools \
      NetworkManager cloud-init qemu-guest-agent open-vm-tools chrony \
      conntrack-tools iproute iptables-nft ethtool socat \
      cloud-utils-growpart xfsprogs zstd \
      iscsi-initiator-utils nfs-utils \
      ca-certificates openssh-server sudo \
 && dnf clean all \
 && rm -rf /var/cache/dnf /var/log/dnf*

# Bare metal: the rest of the kernel's drivers (NICs and storage controllers VMs never
# see), their firmware, and an initramfs that isn't limited to the build host's hardware,
# so the root disk is found behind any controller. The modules match the image's kernel.
RUN case "$VARIANT" in \
      vm) ;; \
      metal) \
        set -e; \
        kver="$(ls /usr/lib/modules)"; \
        [ "$(echo "$kver" | wc -w)" -eq 1 ] || { echo "expected one kernel, found: $kver" >&2; exit 1; }; \
        dnf -y install "kernel-modules-core-$kver" "kernel-modules-$kver" "kernel-modules-extra-$kver" linux-firmware; \
        env DRACUT_NO_XATTR=1 dracut --force --no-hostonly --kver "$kver" "/usr/lib/modules/$kver/initramfs.img"; \
        dnf clean all; rm -rf /var/cache/dnf /var/log/dnf* ;; \
      *) echo "VARIANT must be vm or metal, got '$VARIANT'" >&2; exit 1 ;; \
    esac

COPY rootfs/ /
# /opt is read-only in image mode. CNI plugins that install themselves at runtime (Cilium)
# write to /opt/cni/bin, so point it at /var (created by tmpfiles.d at boot).
# The kubernetes-cni package (a kubelet dependency) already installs the stock plugins into
# /opt/cni/bin, and `ln -sfn` into an existing directory only creates a stray link inside it.
# Move the plugins to /usr/libexec/cni (in CRI-O's plugin_dirs), then make /opt/cni/bin the link.
RUN mkdir -p /usr/libexec/cni \
 && mv /opt/cni/bin/* /usr/libexec/cni/ \
 && rm -rf /opt/cni/bin \
 && ln -s /var/lib/cni/bin /opt/cni/bin
# CAPMOX learns that a node finished cloud-init through the guest agent: it runs
# `cloud-init status` with guest-exec and polls guest-exec-status. Rocky's qemu-ga config
# allows only a fixed list of agent commands, without those two, so CAPMOX would wait
# forever. Add them to the allow-list (and fail the build if the file's shape changes).
# Trade-off: anyone with Proxmox API access to a node VM can run commands in it.
RUN sed -i 's/--allow-rpcs=/--allow-rpcs=guest-exec,guest-exec-status,/' /etc/sysconfig/qemu-ga \
 && grep -q -- '--allow-rpcs=guest-exec,guest-exec-status,' /etc/sysconfig/qemu-ga
# The guest agent's SELinux domain may not run cloud-init, so guest-exec of
# `cloud-init status` gets "Permission denied". Load a narrow policy module that allows
# exactly that (see the .cil file). The module store is under /etc/selinux, which bootc keeps.
RUN semodule -i /usr/share/dciab/selinux/dciab-qemu-ga.cil \
 && semodule -l | grep -qx dciab-qemu-ga
# A bootc node's packages come only with its image, so cloud-init's package module (which
# runs `dnf upgrade` whenever instance data asks, as Proxmox VE's does by default) must never
# run: dnf refuses on the read-only /usr and cloud-init ends in "status: error", which CAPMOX
# reads as a node that never finished. Instance data beats a `package_upgrade: false` here,
# so the module comes out of the package's own final-module list (the script fails the build
# if the list no longer has it).
COPY no-package-module.py /tmp/no-package-module.py
RUN python3 /tmp/no-package-module.py \
 && ! grep -q package_update_upgrade_install /etc/cloud/cloud.cfg.d/91-dciab-no-package-module.cfg \
 && rm /tmp/no-package-module.py
# cloud-init's units are enabled by the package's systemd presets.
RUN systemctl enable NetworkManager crio kubelet chronyd sshd qemu-guest-agent vmtoolsd iscsid dciab-growroot

# The base image's /usr/local is an absolute symlink to /var/usrlocal, which bootc's
# `container lint` (runtime-deps, bootc 1.17) rejects as "a path led outside of the
# filesystem". A relative link means the same thing and passes.
RUN ln -sfn ../var/usrlocal /usr/local

LABEL containers.bootc=1
STOPSIGNAL SIGRTMIN+3
CMD ["/sbin/init"]
RUN bootc container lint
