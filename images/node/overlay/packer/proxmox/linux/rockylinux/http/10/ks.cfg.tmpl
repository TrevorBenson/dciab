# Rocky Linux 10 kickstart for the DCiaB node template (Proxmox, image-builder).
# Adapted from image-builder's Rocky 9 Proxmox kickstart and its CentOS Stream 10 one.
# $SSH_PASSWORD is filled in by image-builder's hack/set-ssh-password.sh.

cdrom
repo --name="AppStream" --baseurl="https://download.rockylinux.org/pub/rocky/10/AppStream/x86_64/os/"

text
firstboot --disabled
eula --agreed
keyboard --vckeymap=us --xlayouts='us'
lang en_US.UTF-8
timezone UTC

network --bootproto=dhcp --device=link --onboot=on --ipv6=auto --activate --hostname=rocky10-node

rootpw --lock
user --name=builder --groups=wheel --password=$SSH_PASSWORD --plaintext --shell=/bin/bash

selinux --permissive
firewall --disabled
services --enabled="NetworkManager,sshd,chronyd"

# GPT on BIOS (SeaBIOS) needs a biosboot partition.
bootloader --boot-drive=sda
zerombr
clearpart --all --initlabel --drives=sda
part biosboot --fstype="biosboot" --size=1 --ondisk=sda
part /boot --fstype="ext4" --size=1024 --ondisk=sda
part / --fstype="ext4" --grow --label=slash --ondisk=sda

skipx

%packages --ignoremissing --excludedocs
@core
openssh-server
qemu-guest-agent
sudo
sed
python3
-iwl*firmware
-cockpit
%end

%addon com_redhat_kdump --disable
%end

reboot

%post
echo 'builder ALL=(ALL) NOPASSWD: ALL' > /etc/sudoers.d/builder
chmod 440 /etc/sudoers.d/builder

dnf -y clean all

swapoff -a
sed -ri '/\sswap\s/s/^#?/#/' /etc/fstab

dnf install -y cloud-init systemd-resolved

# Allow guest-exec through qemu-guest-agent.
echo 'FILTER_RPC_ARGS=$FILTER_RPC_ARGS,guest-exec' >> /etc/sysconfig/qemu-ga
systemctl enable qemu-guest-agent systemd-resolved

# EL10 has no network-scripts: drop the installer's NetworkManager profile so clones
# get their addresses from cloud-init instead of the build VM's.
rm -f /etc/NetworkManager/system-connections/*.nmconnection
%end
