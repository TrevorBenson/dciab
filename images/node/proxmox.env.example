# Proxmox connection and placement for images/node/build.sh.
# Copy outside the repo (for example ~/.dciab/proxmox-build.env), fill in, chmod 600.
# Passed to the image-builder container with --env-file: one KEY=value per line, no quotes.

# API endpoint, ending in /api2/json
PROXMOX_URL=https://pve01.lab.example.com:8006/api2/json
# API token: PROXMOX_USERNAME is <user>@<realm>!<token id>, PROXMOX_TOKEN is its secret.
# The user needs the privileges listed in image-builder's Proxmox guide (images/node/README.md).
PROXMOX_USERNAME=image-builder@pve!dciab
PROXMOX_TOKEN=00000000-0000-0000-0000-000000000000
# Node that runs the build VM and keeps the template
PROXMOX_NODE=pve01
# Storage for the uploaded ISO (content type ISO) and for the template's disk
PROXMOX_ISO_POOL=local
PROXMOX_STORAGE_POOL=local-lvm
# Bridge for the build VM. Its network needs DHCP, and must reach this machine
# (Packer serves the kickstart over HTTP) and the internet (packages).
PROXMOX_BRIDGE=vmbr0
# VLAN tag on that bridge; leave empty for none
PROXMOX_VLAN=

# Optional DCiaB settings (read by build.sh, not by image-builder)
# VMID for the template; empty lets Proxmox choose
DCIAB_TEMPLATE_VMID=
# Storage type of PROXMOX_STORAGE_POOL when not lvm (lvm-thin, zfspool, rbd, dir, ...)
DCIAB_STORAGE_POOL_TYPE=
# Template disk size (image-builder default 20G); nodes can request more, not less
DCIAB_DISK_SIZE=
# CPU type of the build VM; Rocky 10 needs x86-64-v3 or newer (default x86-64-v3)
DCIAB_CPU_TYPE=
