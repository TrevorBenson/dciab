# DCiaB Day 0 NTP server: chrony on Rocky Linux 10 minimal.
#
# Serves time on the bootstrap host until the platform's own NTP takes over. It never sets
# the host clock (-x), so it needs no SYS_TIME capability. The configuration is rendered
# from dciab.yaml by `dciab services` and mounted at /etc/dciab/chrony.conf; the image
# holds no site values.
#
# Built with build.sh when the archive is built, never at the site: microdnf needs the Rocky
# Linux repositories. CI publishes it and bundle.lock pins it as day0.images.chrony.
# BASE_IMAGE is bundle.lock day0.images.chronyBase (pinned by digest).
ARG BASE_IMAGE
FROM ${BASE_IMAGE}

RUN microdnf -y install chrony \
 && microdnf clean all \
 && rm -rf /var/cache/yum /var/cache/dnf

EXPOSE 123/udp
ENTRYPOINT ["/usr/sbin/chronyd", "-d", "-x", "-f", "/etc/dciab/chrony.conf"]
