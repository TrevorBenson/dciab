[Unit]
Description=Configure the DCiaB bootstrap appliance from dciab.yaml
# The stick is optional after the install: its config is copied to /var/lib/dciab/site,
# and that copy is used when the stick isn't plugged in.
Wants=var-mnt-dciab.mount
After=var-mnt-dciab.mount NetworkManager.service
Before=sshd.service
ConditionPathExists=|/var/mnt/dciab/dciab.yaml
ConditionPathExists=|/var/lib/dciab/site/dciab.yaml

[Service]
Type=oneshot
RemainAfterExit=yes
Environment=PYTHONPATH=/usr/share/dciab/lib
# Copies the config from the stick when it's there, prints the validation report, sets up
# admin logins, and configures the network only when nothing in spec.bootstrap,
# spec.network or spec.identity has errors (see setup.py).
ExecStart=/usr/bin/python3 -m dciab_bootstrap_host.setup --usb /var/mnt/dciab --site /var/lib/dciab/site
StandardOutput=journal+console
StandardError=journal+console

[Install]
WantedBy=multi-user.target
